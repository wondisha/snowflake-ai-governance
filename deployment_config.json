        "cost_agent",
        "spillage_agent",
        "health_agent",
        "approval_workflow",
        "orchestrator"
      ]
    },
    "phase2": {
      "enabled": true,
      "name": "Automation & Integration",
      "timeout_minutes": 20,
      "components": [
        "remediation_agent",
        "workload_intelligence",
        "data_governance_agent",
        "slack_bot",
        "rest_api",
        "external_integrations"
      ]
    },
    "phase3": {
      "enabled": true,
      "name": "ML & Intelligence",
      "timeout_minutes": 15,
      "components": [
        "ml_anomaly_detection",
        "cost_allocation_engine"
      ]
    },
    "phase4": {
      "enabled": true,
      "name": "Enterprise Scale",
      "timeout_minutes": 10,
      "components": [
        "advanced_ml_agent",
        "multi_account_controller"
